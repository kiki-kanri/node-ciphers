{
  "name": "node-ciphers",
  "type": "module",
  "version": "6.1.6",
  "description": "Lightweight AES and DES encryption library for Node.js, featuring flexible encoding, multiple cipher modes, and TypeScript support.",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiki-kanri/node-ciphers.git"
  },
  "keywords": [
    "3des",
    "aes",
    "aes ccm",
    "aes ctr",
    "aes gcm",
    "cbc",
    "cfb",
    "cfb1",
    "cfb8",
    "cipher",
    "cipher modes",
    "crypto",
    "decryption",
    "des",
    "ecb",
    "encryption",
    "iv generation",
    "json encryption",
    "lightweight",
    "nodejs",
    "ofb",
    "result",
    "secure",
    "stream"
  ],
  "sideEffects": false,
  "exports": {
    "./aes": "./dist/aes/index.js",
    "./des": "./dist/des/index.js",
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": null
    },
    "./package.json": "./package.json"
  },
  "files": [
    "./dist",
    "./src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --cache --concurrency=auto --max-warnings 0",
    "lint:fix": "eslint --cache --concurrency=auto --fix --max-warnings 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --clean --hideAuthorEmail --push --release && npm publish",
    "test": "NODE_OPTIONS=--openssl-legacy-provider vitest run --coverage",
    "test:watch": "NODE_OPTIONS=--openssl-legacy-provider vitest watch --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {},
  "dependencies": {
    "type-fest": "^6.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@arethetypeswrong/core": "^0.18.5",
    "@kikiutils/eslint-config": "^11.2.1",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.15.0",
    "knip": "^6.48.0",
    "publint": "^0.3.25",
    "ts-extras": "^3.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.6.0",
    "vitest": "^5.1.1"
  }
}
